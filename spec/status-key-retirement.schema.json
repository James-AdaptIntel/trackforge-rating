{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trackforge:rating:status-key-retirement:1",
  "title": "TrackForge status key retirement, format 1",
  "description": "status-keys/retired/<fingerprint>.json: a status key leaves service on `date`, by a rating signing key's endorsement. See status.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "fingerprint", "date", "reason", "endorsed_by", "endorsement"],
  "properties": {
    "format": {"const": "trackforge-status-key-retirement/1"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "reason": {"enum": ["scheduled", "compromise"]},
    "endorsed_by": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "endorsement": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
