{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trackforge:rating:statement:1",
  "title": "TrackForge rating statement, format 1",
  "description": "The small document that is signed, timestamped and logged. Stored and hashed as canonical JSON; see statement.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "rating_id", "catalogue_ref", "issue_number", "issue_date", "review_date",
    "letter", "tuple_hash", "rule_book", "proof_pack_sha256", "previous_statement_sha256",
    "signing_key"
  ],
  "properties": {
    "format": {"const": "trackforge-rating-statement/1"},
    "rating_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "catalogue_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "issue_number": {"type": "integer", "minimum": 1},
    "issue_date": {"$ref": "#/$defs/date"},
    "review_date": {"$ref": "#/$defs/date"},
    "letter": {"enum": ["AAA", "AA", "A", "BBB", "BB", "B", "CCC", "CC", "C", "D"]},
    "tuple_hash": {"$ref": "#/$defs/sha256"},
    "rule_book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "proof_pack_sha256": {"$ref": "#/$defs/sha256"},
    "previous_statement_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "signing_key": {"$ref": "#/$defs/sha256"}
  },
  "if": {"properties": {"issue_number": {"const": 1}}},
  "then": {"properties": {"previous_statement_sha256": {"type": "null"}}},
  "else": {"properties": {"previous_statement_sha256": {"type": "string"}}},
  "$comment": "review_date must fall after issue_date; JSON Schema cannot compare dates, the checker does.",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
