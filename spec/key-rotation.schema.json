{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trackforge:rating:key-rotation:1",
  "title": "TrackForge key rotation, format 1",
  "description": "keys/rotations/<seq, six digits>.json: ends a key's service (scheduled) or revokes it (compromise). Signatures are over the canonical JSON of the record without the signatures member. See keys.md for who must sign.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "seq", "date", "old_key", "new_key", "reason", "signatures"],
  "properties": {
    "format": {"const": "trackforge-key-rotation/1"},
    "seq": {"type": "integer", "minimum": 1},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "old_key": {"$ref": "#/$defs/fingerprint"},
    "new_key": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fingerprint"}]},
    "reason": {"enum": ["scheduled", "compromise"]},
    "signatures": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "propertyNames": {"pattern": "^[0-9a-f]{64}$"},
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
    }
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
